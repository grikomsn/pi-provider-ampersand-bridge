{
  "name": "pi-provider-ampersand-bridge",
  "version": "0.1.0",
  "description": "Unofficial ai& (api.aiand.com) model provider for Pi with live model discovery",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-provider",
    "ampersand",
    "ampersand-bridge",
    "aiand",
    "pi-extension",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grikomsn/pi-provider-ampersand-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/grikomsn/pi-provider-ampersand-bridge/issues"
  },
  "homepage": "https://github.com/grikomsn/pi-provider-ampersand-bridge#readme",
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "package": "npm pack --dry-run",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
